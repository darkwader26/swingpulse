# Database configuration
DATABASE_URL=postgresql+asyncpg://swingpulse:swingpulse@localhost:5432/swingpulse
REDIS_URL=redis://localhost:6379/0

# Application
ENVIRONMENT=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# Trading
EXECUTION_MODE=paper
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_POSITIONS=8
MAX_SECTOR_EXPOSURE=0.30

# Data provider (Polygon.io / Yahoo Finance fallback)
DATA_PROVIDER=yfinance
POLYGON_API_KEY=

# Broker (Alpaca paper)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
